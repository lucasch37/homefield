# FastAPI service serving GET /hazards (server/). Required in production.
BACKEND_URL=http://localhost:8000
# Server-only keys. Never use a NEXT_PUBLIC_ name for them.
# Gemini writes the summary. Without it the summary is written straight from the data.
GEMINI_API_KEY=
# Optional: defaults to gemini-flash-latest (Google's current Flash model).
# GEMINI_MODEL=gemini-flash-latest
# xAI powers Grok Voice. Without it, voice says it isn't connected.
XAI_API_KEY=
# Optional overrides, only for tests against local stand-ins:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime?model=grok-voice-latest
# Partner links under the search button (public, inlined at build time). Query string appended to
# Zillow and Redfin links, e.g. your affiliate/partner ID. Defaults to Homefield UTM tags.
# NEXT_PUBLIC_ZILLOW_AFFILIATE_PARAMS=utm_source=homefield&utm_medium=referral
# NEXT_PUBLIC_REDFIN_AFFILIATE_PARAMS=utm_source=homefield&utm_medium=referral
