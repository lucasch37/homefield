# FastAPI service serving GET /hazards (server/). Required in production.
BACKEND_URL=http://localhost:8000
# Server-only xAI key for the Grok summary and Grok Voice. Never use a NEXT_PUBLIC_ name for it.
# Without it the app still works: the summary is written from the data and voice shows "not connected".
XAI_API_KEY=
# Text model for the written summary. Use one enabled for your xAI account.
XAI_TEXT_MODEL=grok-4.7
# Optional overrides, only for tests against local stand-ins:
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime?model=grok-voice-latest
